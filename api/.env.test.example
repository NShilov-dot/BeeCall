# Test environment — keeps test runs off your dev DB.
#
# Copy to api/.env.test (gitignored) and adjust if your local postgres / redis
# bind on non-default ports. `make test-api` does the copy for you on first
# run via `make test-env-setup`.
#
# api/conftest.py loads this file via dotenv before importing api.constants,
# so DATABASE_URL / REDIS_URL must be valid for the test infra to come up.

ENVIRONMENT="test"
LOG_LEVEL="DEBUG"

BACKEND_API_ENDPOINT="http://localhost:8000"
UI_APP_URL="http://localhost:3000"

# Postgres — the conftest appends _test to the DB name and runs Alembic
# migrations against the *_test* database, then uses transaction savepoints
# for per-test isolation. So this URL should point at a running postgres
# (e.g. the one from docker-compose-local.yaml) that the test session is
# allowed to create databases on.
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/postgres"

# Redis — used by ari_manager (channel → workflow_run mapping) and worker_sync.
# Tests that touch redis expect this to be reachable.
REDIS_URL="redis://:redissecret@localhost:6379"

# Storage is mocked in unit tests but still imported at module load.
ENABLE_AWS_S3="false"
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=voice-audio
MINIO_SECURE=false

# TURN — required at import time even though unit tests don't use it.
TURN_HOST=localhost
TURN_SECRET=test-turn-secret
